# App Port (defaults to 3000)
PORT=3000

# MongoDB Connection URI
# Local development (Docker Compose): mongodb://admin:adminpass@mongo:27017/Myblogs?authSource=admin
# Local development (standalone MongoDB): mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017

# CORS Origin config (comma-separated list, or '*' for all)
CORS_ORIGIN=*

# JWT Secrets (Generate secure random strings for these in production)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
ACCESS_TOKEN_EXPIRY=3600 # 1 hour in seconds

REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=604800 # 7 days in seconds

# Temporary Token Expiry for verification (in milliseconds)
USER_TEMPORARY_TOKEN_EXPIRY=1200000 # 20 minutes

# ImageKit Configuration (for media/image uploads)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=public_your_public_key
IMAGEKIT_PRIVATE_KEY=private_your_private_key
